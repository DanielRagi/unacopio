# PLANTILLA. Este archivo SÍ se sube al repo.
#
# No escribas valores reales aquí: cópialo a .env.local (que está en .gitignore)
# y llena allá. GitHub bloquea el push si detecta una llave de Supabase en este
# archivo, y con razón.
#
#   cp .env.example .env.local
#
# Los valores salen de Supabase → Project Settings → API.
# Las mismas variables van configuradas en Vercel.

# Públicas: llegan al navegador. Es correcto que sean visibles.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA: solo servidor. Salta RLS por completo.
# No prefijar con NEXT_PUBLIC_ jamás.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio, para metadatos y enlaces compartidos.
NEXT_PUBLIC_SITIO_URL=https://unacopio.co
